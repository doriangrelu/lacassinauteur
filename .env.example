# Copier ce fichier vers ".env" (jamais commité, cf. .gitignore) à la racine du
# dépôt sur le VPS, puis renseigner les vraies valeurs avant de lancer
# "docker compose -f docker-compose.prod.yml up -d". Voir ADR-0016
# (docs/architecture/decisions/0016-deploiement-caddy-prod.md) pour le contexte.

# Fait pointer les commandes "docker compose" lancées sans "-f" (c'est le cas de
# scripts/backup.sh, scripts/restore.sh et scripts/deploy.sh) vers la stack de
# production plutôt que vers le docker-compose.yml de développement.
COMPOSE_FILE=docker-compose.prod.yml

# --- Base de données PostgreSQL ---
# Nom de la base applicative.
POSTGRES_DB=site
# Utilisateur PostgreSQL applicatif.
POSTGRES_USER=site
# Mot de passe PostgreSQL — générer une valeur forte (ex. "openssl rand -base64 32"), jamais réutiliser "site" (valeur du docker-compose.yml de dev).
POSTGRES_PASSWORD=

# --- Application ---
# Domaine public du site, utilisé pour les liens absolus dans les emails (newsletter, cf. application.yml).
APP_URL_BASE=https://thierrylacassin-auteur.fr

# --- Newsletter (Brevo, cf. ADR-0002 / ADR-0013) ---
# Clé API Brevo (compte Brevo > Paramètres SMTP & API > Clés API).
BREVO_API_KEY=
# Adresse expéditeur des emails newsletter (doit être validée/vérifiée dans Brevo).
BREVO_EXPEDITEUR_EMAIL=newsletter@thierrylacassin-auteur.fr
# Nom expéditeur affiché dans les emails newsletter.
BREVO_EXPEDITEUR_NOM=Thierry Lacassin

# --- Captcha (reCAPTCHA v3, cf. ADR-0019) ---
# Cle de site (publique, cote navigateur) et cle secrete (serveur), obtenues sur
# https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Identity : reinitialisation de mot de passe (cf. ADR-0018) ---
# Secret de signature du JWT de reinitialisation (HS256, min. 32 caracteres) —
# generer une valeur forte (ex. "openssl rand -base64 48"), jamais reutiliser la
# valeur par defaut de dev.
JWT_RESET_SECRET=

# --- Contact (SMTP générique, cf. ADR-0014) ---
# Adresse de l'auteur qui reçoit les notifications du formulaire de contact.
CONTACT_EMAIL_AUTEUR=thierry@thierrylacassin-auteur.fr
# Hôte du serveur SMTP (ex. smtp.gmail.com, ou relais transactionnel dédié type Brevo).
CONTACT_SMTP_HOST=
# Port du serveur SMTP (587 = STARTTLS, valeur usuelle).
CONTACT_SMTP_PORT=587
# Identifiant de connexion SMTP.
CONTACT_SMTP_USERNAME=
# Mot de passe de connexion SMTP (ou mot de passe d'application si Gmail avec validation en 2 étapes).
CONTACT_SMTP_PASSWORD=
# Adresse expéditeur des emails de notification de contact.
CONTACT_SMTP_EXPEDITEUR_EMAIL=contact@thierrylacassin-auteur.fr
# Nom expéditeur affiché dans les emails de notification de contact.
CONTACT_SMTP_EXPEDITEUR_NOM=Site Thierry Lacassin

# --- Caddy (reverse proxy / HTTPS, cf. ADR-0016) ---
# Adresse email transmise à Let's Encrypt pour les notifications d'expiration de certificat (pas un secret, mais à personnaliser plutôt que laisser vide).
CADDY_ACME_EMAIL=contact@thierrylacassin-auteur.fr

# --- Keycloak (IAM, cf. ADR-0027) ---
# Base et rôle Postgres dédiés dans la même instance "db" (créés manuellement une
# fois, cf. docs/mode-operatoire-deploiement.md) — jamais réutiliser POSTGRES_USER.
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
# Mot de passe du rôle Postgres dédié à Keycloak — générer une valeur forte (ex. "openssl rand -base64 32"), jamais réutiliser POSTGRES_PASSWORD.
KEYCLOAK_DB_PASSWORD=
# Identifiants du compte administrateur créé au tout premier démarrage uniquement (sans effet aux démarrages suivants).
KC_BOOTSTRAP_ADMIN_USERNAME=
# Générer une valeur forte (ex. "openssl rand -base64 24"), jamais de valeur devinable.
KC_BOOTSTRAP_ADMIN_PASSWORD=
