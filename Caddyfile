# Reverse proxy pour le site Thierry Lacassin (cf. ADR-0016 et
# docs/architecture/tech-stack.md §Déploiement — OVHcloud).
#
# HTTPS automatique (Let's Encrypt) dès que Caddy démarre avec un vrai nom de
# domaine pointé vers ce serveur : aucune configuration TLS manuelle nécessaire,
# c'est le comportement par défaut de Caddy.
#
# "reverse_proxy" ajoute par défaut les en-têtes X-Forwarded-For/-Proto/-Host vers
# l'upstream ; côté application, "server.forward-headers-strategy: framework"
# (application-prod.yml) les exploite déjà pour restituer la vraie IP client
# (nécessaire au rate limiting anti brute-force, ADR-0008) et le bon schéma (https)
# — rien à ajouter ici.
{
	email {$CADDY_ACME_EMAIL:contact@thierrylacassin-auteur.fr}
}

# Domaine canonique : apex sans "www". Choix arbitraire (les deux se valent en SEO
# du moment qu'une redirection 301 est en place) — cf. ADR-0016.
thierrylacassin-auteur.fr {
	encode gzip zstd
	reverse_proxy app:8080
}

www.thierrylacassin-auteur.fr {
	redir https://thierrylacassin-auteur.fr{uri} permanent
}

# Second nom de domaine (deja pointe vers ce serveur) : redirection pure vers le
# domaine canonique, meme logique que le www. ci-dessus — evite le contenu
# duplique (penalite SEO) plutot que de servir le site sur deux domaines.
leblogdethierry.fr {
	redir https://thierrylacassin-auteur.fr{uri} permanent
}

www.leblogdethierry.fr {
	redir https://thierrylacassin-auteur.fr{uri} permanent
}
